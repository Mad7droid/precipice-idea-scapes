# Cloudflare Pages response headers. Copied verbatim into dist/ by Vite.
#
# CSP lives here rather than in a <meta> tag so it applies to the deployed site only —
# a meta CSP would also hit `pnpm dev` and block Vite's HMR websocket.
#
# The one `sha256-` below covers the pre-paint theme script inlined in index.html. Editing
# that script invalidates the hash and the theme silently stops applying, so csp.test.ts
# recomputes it and fails when the two drift.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://precipice-ai-proxy.precipice.workers.dev; script-src 'self' 'sha256-Su/htfNLoOq1wMoi0QWMXhvrCg/hGbTFGjfv8xj3xtE='
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
