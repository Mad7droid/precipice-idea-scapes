{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-credentials",
  "description": "Only the local main window can manage the one Anthropic credential and relay local MCP connections.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "allow-read-api-key",
    "allow-save-api-key",
    "allow-remove-api-key",
    "allow-mcp-ready",
    "allow-mcp-send",
    "allow-mcp-install-client",
    "allow-mcp-helper-path",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
