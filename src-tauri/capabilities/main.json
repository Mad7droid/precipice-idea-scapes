{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-credentials",
  "description": "Only the local main window can manage the Anthropic credential and the optional TypeSafe routing credential, relay local MCP connections, and run local dictation.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS"
  ],
  "permissions": [
    "allow-chatgpt-status",
    "allow-chatgpt-connect",
    "allow-chatgpt-disconnect",
    "allow-chatgpt-cancel-login",
    "allow-chatgpt-select",
    "allow-chatgpt-request",
    "allow-ai-cancel",
    "allow-claude-status",
    "allow-claude-connect",
    "allow-claude-request",
    "allow-open-ai-settings",
    "allow-read-api-key",
    "allow-save-api-key",
    "allow-remove-api-key",
    "allow-read-typesafe-key",
    "allow-save-typesafe-key",
    "allow-remove-typesafe-key",
    "allow-jev-route",
    "allow-mcp-ready",
    "allow-mcp-send",
    "allow-mcp-install-client",
    "allow-mcp-helper-path",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-read-agent-session",
    "allow-save-agent-session",
    "allow-open-agent-signin",
    "deep-link:default",
    "allow-dictation-status",
    "allow-dictation-install",
    "allow-dictation-cancel-install",
    "allow-dictation-prepare",
    "allow-dictation-start",
    "allow-dictation-stop",
    "allow-dictation-cancel"
  ]
}
