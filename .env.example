VITE_AI_PROXY_URL=https://REPLACE_WITH_AI_PROXY_HOST
# The public, read-only viewer and publishing controls use this separate Worker. Keep the real
# production endpoint in your deployment environment, not this committed example.
VITE_PUBLICATION_API_URL=https://REPLACE_WITH_PUBLICATION_API_HOST
# Public Turnstile site key for the invite-only publishing sign-in flow. This is not a secret.
# Create a local widget for localhost rather than reusing the production site key.
VITE_TURNSTILE_SITE_KEY=
# The hosted MCP connector Worker (worker/mcp). Agents connect to `<this>/mcp`; the open app
# keeps a hibernating socket to `<this>/relay` so they can reach your local library.
VITE_MCP_URL=https://REPLACE_WITH_MCP_HOST
