{
  "name": "precipice",
  "private": true,
  "version": "0.1.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate:mcp-discovery && tsc --noEmit && vite build",
    "generate:mcp-discovery": "tsx scripts/desktop-mcp-discovery.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mcp": "node --test mcp/*.mcp-test.mjs",
    "mcp": "node mcp/server.mjs",
    "verify": "pnpm check:version && pnpm check:worker && pnpm build && pnpm test",
    "check:worker": "tsc -p tsconfig.worker.json",
    "check:version": "node scripts/check-version.mjs",
    "smoke:release": "node --env-file=.env.production.local scripts/smoke-release.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app,dmg",
    "desktop:install": "bash scripts/install-desktop.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.154",
    "dagre": "^0.8.5",
    "dexie": "^4.4.7",
    "jose": "^6.2.13",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-oauth-provider": "^1.1.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/dagre": "^0.7.53",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.11",
    "wrangler": "4.120.0"
  }
}
