            "detail": "No account required to browse."
          },
          {
            "id": "s2",
            "label": "Enter phone number",
            "detail": "One-tap SMS autofill."
          },
          {
            "id": "s3",
            "label": "Verify identity",
            "detail": "Document scan plus liveness check."
          },
          {
            "id": "s4",
