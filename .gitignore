# Secrets. `*.local` above does not match `.env`, and the example file is meant to be committed.
.env
.env.*
!.env.example

# Wrangler's local dev state, which caches secrets and request data.
.wrangler

# Deployment-specific Worker identity and resource IDs. Keep the real file local; commit only
# `wrangler.publish.example.toml` so GitHub never advertises the production Worker hostname.
wrangler.publish.toml

# Machine-local Conductor config. `*.local` above does not match `settings.local.toml`.
.conductor/settings.local.toml

